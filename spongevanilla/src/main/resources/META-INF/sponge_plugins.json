{
    "loader": {
        "name": "java_plain",
        "version": "1.0"
    },
    "license": "${license}",
    "plugins": [
        {
            "id": "${mod_id}",
            "name": "${mod_name}",
            "version": "${version}",
            "entrypoints": [
                "org.inspirenxe.strata.spongevanilla.StrataSpongeVanilla"
            ],
            "description": "${description}",
            "contributors": [
                {
                    "name": "${mod_author}"
                }
            ],
            "dependencies": [
                {
                    "id": "spongeapi",
                    "version": "${sponge_api_version_range}",
                    "load-order": "after",
                    "optional": false
                },
                {
                    "id": "minecraft",
                    "version": "${minecraft_version_range}",
                    "load-order": "undefined",
                    "optional": false
                }
            ]
        }
    ]
}
